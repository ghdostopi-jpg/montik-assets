# Copy this file to `.env` and fill in your keys. The real .env is gitignored.
# Every script loads this automatically.

# Transcription — set ONE of these two (AssemblyAI is tried first if both are set):
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=

# Optional — polish_transcript.py's context-aware mishearing-correction pass.
# ANTHROPIC_API_KEY=

# Optional — b-roll stock footage fetch in video-edit / video-edit-longform.
# PEXELS_API_KEY=

# Add other external tool keys here as the pipeline grows.
